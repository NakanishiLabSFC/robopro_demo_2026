# TB3 接続設定
#   このファイルを config.env にコピーして自分の環境の値を入れる (config.env は .gitignore 済み)
#   scripts/demo_up.sh と scripts/tb3stop.sh が自動で source する。
#
#   TB3_PASSWORD を空のままにすると「時刻同期」と「tb3stop」がスキップされる。
#   パスワードをファイルに置きたくない場合は ssh-copy-id で公開鍵認証にするのが推奨。

TB3_USER=ubuntu
TB3_IP=192.168.3.9
TB3_PASSWORD=

# PC(Ubuntu)側のIP。Unity の ROS Settings に入れる値。
PC_IP=192.168.3.247

# TB3 の .bashrc に合わせる (TB3 側が 30 固定)
ROS_DOMAIN_ID=30
